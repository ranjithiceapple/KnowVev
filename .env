# ============================================================================
# KNOWVEC RAG PIPELINE - ENVIRONMENT CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
# Set to DEBUG for detailed extraction logs (INFO for production)
LOG_LEVEL=DEBUG

# Log format: 'standard' for human-readable, 'json' for structured logs
LOG_FORMAT=standard

# Enable file logging (logs saved to LOG_DIR)
ENABLE_FILE_LOGGING=true

# Directory for log files
LOG_DIR=logs

# ----------------------------------------------------------------------------
# QDRANT CONFIGURATION (VECTOR STORE)
# ----------------------------------------------------------------------------
# Qdrant server URL (connecting to existing enterprise-rag-qdrant container)
QDRANT_URL=http://localhost:6333

# Qdrant API key (optional, leave empty for local development)
QDRANT_API_KEY=

# Default collection name (using different collection to avoid conflicts)
QDRANT_COLLECTION=documents

QDRANT_TIMEOUT=5

QDRANT_RETRY_COUNT=3

# ----------------------------------------------------------------------------
# OPENSEARCH CONFIGURATION (KEYWORD STORE FOR HYBRID SEARCH)
# ----------------------------------------------------------------------------
# Enable/disable OpenSearch hybrid search
OPENSEARCH_ENABLED=true

# OpenSearch server host
OPENSEARCH_HOST=localhost

# OpenSearch server port
OPENSEARCH_PORT=9200

# OpenSearch authentication
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=ArivurAI@123

# SSL/TLS configuration
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_SSL_SHOW_WARN=false

# Index name for keyword documents
OPENSEARCH_INDEX=knowvec_keywords

# Connection parameters
OPENSEARCH_TIMEOUT=30
OPENSEARCH_MAX_RETRIES=3

# ----------------------------------------------------------------------------
# HYBRID SEARCH CHUNK GENERATION
# ----------------------------------------------------------------------------
# Generate separate chunks for headings (useful for TOC-style search)
GENERATE_HEADING_CHUNKS=true

# Generate separate chunks for numbered clauses/sections
GENERATE_CLAUSE_CHUNKS=true

# Generate chunks from document metadata (title, author, etc.)
GENERATE_METADATA_CHUNKS=true

# Generate document summary chunks
GENERATE_SUMMARY_CHUNKS=true

# Keyword extraction settings
KEYWORD_MAX_KEYWORDS=50
KEYWORD_MIN_WORD_LENGTH=3
KEYWORD_INCLUDE_PHRASES=true

# ----------------------------------------------------------------------------
# EMBEDDING MODEL CONFIGURATION
# ----------------------------------------------------------------------------
# Model name for sentence embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Embedding dimension (768 for bge-base-en-v1.5)
EMBEDDING_DIMENSION=768

# ----------------------------------------------------------------------------
# PROCESSING CONFIGURATION
# ----------------------------------------------------------------------------
# Maximum chunk size in characters
MAX_CHUNK_SIZE=1500

# Target chunk size for optimal retrieval
TARGET_CHUNK_SIZE=1200

# Enable chunk overlap for better context
ENABLE_OVERLAP=true

# Overlap size in characters
OVERLAP_SIZE=250

# Respect page boundaries when chunking
RESPECT_PAGE_BOUNDARIES=false

# Keep tables intact (don't split)
KEEP_TABLES_INTACT=true

# Remove Table of Contents pages
REMOVE_TOC_PAGES=true

# Protect headings during normalization
PROTECT_HEADINGS=true

# Protect tables during normalization
PROTECT_TABLES=true

# Protect code blocks during normalization
PROTECT_CODE_BLOCKS=true

# Detect multi-column layouts
DETECT_MULTI_COLUMN=true

# Deduplicate chunks
DEDUPLICATE_CHUNKS=true

# Aggressive text cleaning
AGGRESSIVE_TEXT_CLEANING=false

# ----------------------------------------------------------------------------
# DOCUMENT SUMMARY CONFIGURATION
# ----------------------------------------------------------------------------
# Generate document summaries automatically
GENERATE_DOCUMENT_SUMMARY=true

# Summary generation method: 'extractive', 'abstractive', or 'hybrid'
SUMMARY_METHOD=hybrid

# Maximum summary length in characters
SUMMARY_MAX_LENGTH=500

# Minimum document length to generate summary
SUMMARY_MIN_DOC_LENGTH=1000

# ----------------------------------------------------------------------------
# SEARCH CONFIGURATION
# ----------------------------------------------------------------------------
# Minimum similarity score for search results (0.0 to 1.0)
MIN_SIMILARITY_SCORE=0.3

# Default number of results to return
DEFAULT_SEARCH_LIMIT=10

# Maximum allowed search results
MAX_SEARCH_LIMIT=100

# ----------------------------------------------------------------------------
# API CONFIGURATION
# ----------------------------------------------------------------------------
# FastAPI host
API_HOST=0.0.0.0

# FastAPI port
API_PORT=8007

# Enable API debug mode (auto-reload)
API_DEBUG=false

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=50

# CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# PERFORMANCE CONFIGURATION
# ----------------------------------------------------------------------------
# Number of workers for batch processing
NUM_WORKERS=4

# Batch size for embedding generation
EMBEDDING_BATCH_SIZE=32

# Cache size for processed documents
CACHE_SIZE=100

# ----------------------------------------------------------------------------
# DEBUG & DEVELOPMENT
# ----------------------------------------------------------------------------
# Show progress bars during processing
SHOW_PROGRESS=true

# Enable detailed timing logs
ENABLE_TIMING_LOGS=true

# Enable memory profiling
ENABLE_MEMORY_PROFILING=false

# ----------------------------------------------------------------------------
# TOPIC MODELING CONFIGURATION
# ----------------------------------------------------------------------------
# Enable/disable topic modeling feature
ENABLE_TOPIC_MODELING=true

# Number of topics to extract
TOPIC_N_TOPICS=10

# TF-IDF vocabulary size
TOPIC_MAX_FEATURES=5000

# Minimum document frequency
TOPIC_MIN_DF=1

# Maximum document frequency (as percentage)
TOPIC_MAX_DF=0.85

# Model storage location
TOPIC_MODEL_DIR=models/topics

# Retrain after N new documents
TOPIC_RETRAIN_THRESHOLD_DOCS=100

# Or retrain after 20% growth
TOPIC_RETRAIN_THRESHOLD_PCT=0.20

# ----------------------------------------------------------------------------
# PIPELINE VERSION
# ----------------------------------------------------------------------------
VERSION=1.0

# ============================================================================
# NOTES FOR OPENSEARCH CONFIGURATION
# ============================================================================
# 
# 1. Local Development:
#    - Default settings work for Docker container on localhost
#    - Username: admin
#    - Password: ArivurAI@123 (injected at container startup)
#
# 2. Remote Server (e.g., iceapple-server1):
#    - Change OPENSEARCH_HOST=iceapple-server1
#    - Keep port 9200 (default)
#    - May need to enable SSL: OPENSEARCH_USE_SSL=true
#
# 3. Production Deployment:
#    - IMPORTANT: Change OPENSEARCH_PASSWORD to a strong unique password
#    - Enable SSL for security: OPENSEARCH_USE_SSL=true
#    - Set OPENSEARCH_VERIFY_CERTS=true if using valid certificates
#    - Restrict CORS_ORIGINS to specific domains
#
# 4. Hybrid Search Chunks:
#    - heading: Section headings as separate searchable chunks
#    - clause: Numbered clauses/sections (e.g., "Section 3.2.1")
#    - metadata: Document metadata (title, author, date, etc.)
#    - summary: Generated document summaries
#    - All are indexed to OpenSearch for keyword-based retrieval
#
# 5. Disabling Hybrid Search:
#    - Set OPENSEARCH_ENABLED=false to disable OpenSearch completely
#    - System will use only vector search (Qdrant)
#
# ============================================================================